<nav class="navbar navbar-default bootsnav navbar-sticky navbar-scrollspy" data-minus-value-desktop="70" data-minus-value-mobile="55" data-speed="1000">
    <div class="container">
        <div class="navbar-header">
            <button type="button" class="navbar-toggle" data-toggle="collapse" data-target="#navbar-menu">
                <i class="fa fa-bars"></i>
            </button>
            <a class="navbar-brand" href="/">MechaRift<span></span></a>
        </div>
        
        <div class="collapse navbar-collapse menu-ui-design" id="navbar-menu">
            <ul class="nav navbar-nav navbar-right" data-in="fadeInDown" data-out="fadeOutUp">
                <li class="scroll"><a href="{{ path('app_reclamation') }}">reclamation</a></li>
              
                   
                <li class="scroll"><a href="#new-cars">new cars</a></li>
                <li class="scroll"><a href="#brand">brands</a></li>
                <li class="scroll"><a href="#contact">contact</a></li>

            </ul>
        </div>
    </div>
</nav>	    <!-- End Navigation -->
				</div><!--/.header-area-->
			    <div class="clearfix"></div>

			</div><!-- /.top-area-->
			<!-- top-area End -->

			<div class="container">
				<div class="welcome-hero-txt">
					<h2> contact us !</h2>
					<p>
						
					</p>
					
				</div>
			</div>
<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="model-search-content">
                <form action="{{ path('app_reclamation') }}" method="get">
                    <!-- Title Field -->
                    <div class="form-group">
                        <label for="title" class="form-label">Title</label>
                        <input type="text" id="title" class="form-control" name="title" placeholder="Enter title..."
                               style="height: 45px; border-radius: 5px; border: 1px solid #ccc; padding: 10px;">
                    </div>

                    <!-- Description Field -->
                    <div class="form-group mt-3">
                        <label for="description" class="form-label">Description</label>
                        <textarea id="description" class="form-control" name="description" rows="5"
                                  placeholder="Enter description..."
                                  style="resize: vertical; border-radius: 5px; border: 1px solid #ccc; padding: 10px;"></textarea>
                    </div>

                    <!-- Submit Button -->
                    <div class="text-center mt-4">
                        <button type="submit" class="welcome-btn model-search-btn"
                                style="padding: 12px 30px; font-size: 16px; text-transform: uppercase;">
                            Submit
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>



        {% block body %}{% endblock %}

        <footer id="contact" class="contact">
